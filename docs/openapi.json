          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or revoked actor session"
          },
          "403": {
            "description": "Untrusted server or unauthorized actor"
          },
          "409": {
            "description": "Conflicting record or last administrator removal"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "slug": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "maxLength": 100
                  }
                },
                "required": [
                  "name",
                  "slug"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "security": [
          {
            "AppSession": []
          }
        ]
      }
    },
