{
  "openapi": "3.1.0",
  "info": {
    "title": "Platform Identity \u2014 X.TLD application integration contract",
    "version": "2.0.0",
    "description": "Identity is the sole platform authority for users, provider identities, tenants, memberships, and SSO/application browser sessions. Trusted server admission uses trustedCIDR (default) or configured secret/dual compatibility mode. Directory operations also require an application-session bearer actor. SUPER_ADMIN uses provider-proven session authority unless explicitly granted or removed by another Super Admin; directory email never grants global access. See PLATFORM_CONTRACT.md for rollout, role, online introspection, and data preservation rules."
  },
  "servers": [
    {
      "url": "https://identity.X.TLD",
      "description": "X.TLD is the configured PARENT_DOMAIN (placeholder, normative)."
    }
  ],
  "paths": {
    "/authorize": {
      "get": {
        "operationId": "authorize",
        "summary": "Begin an application login (public, browser)",
        "description": "With a live SSO session, immediately 302s to `redirect_uri` with a one-time `code` (and echoed `state`). Otherwise shows the login page and completes the redirect after authentication. Codes are single-use, expire in 5 minutes, and are bound to the exact `redirect_uri` they were minted for.",
        "parameters": [
          {
            "name": "redirect_uri",
            "in": "query",
            "required": true,
            "description": "HTTPS URL whose host is X.TLD or any subdomain of it. Nothing else is accepted.",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "description": "Opaque value echoed back verbatim on the redirect.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to `redirect_uri` with `?code=<one-time>&state=<echoed>`."
          },
          "200": {
            "description": "Login page (no SSO session yet)."
          },
          "400": {
            "description": "Invalid redirect_uri."
          }
        }
      }
    },
    "/api/token": {
      "post": {
        "operationId": "redeemCode",
        "summary": "Redeem a one-time handoff code (CIDR-trusted server only)",
        "description": "The `redirect_uri` must exactly match the one the code was minted for (exact redirect binding). Codes are single-use and expire 5 minutes after minting; a replayed, expired, or re-bound code yields 400. No client secret is required by the POC contract \u2014 admission is the IPv4/CIDR policy. `user.superAdmin` is the consumed code's `bSuperAdmin` (see superAdmin provenance); it is never recalculated from the email at redemption.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The signed-in identity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing fields, or an invalid, expired, reused, or re-bound code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Caller's resolved IPv4 peer is not allowlisted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/apps/register": {
      "post": {
        "operationId": "registerApp",
        "summary": "Register the application's event endpoint (CIDR-trusted server only)",
        "description": "Called by every app on boot; idempotent per origin. `webhook_url` must be HTTPS on X.TLD or a subdomain. id immediately queues a `ping` delivery to prove the endpoint is reachable.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Registration accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid webhook_url.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Caller's resolved IPv4 peer is not allowlisted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "operationId": "listEvents",
        "summary": "Boot-time event catch-up (CIDR-trusted server only)",
        "description": "Events after `since`, oldest first. Combined with idempotent handling of pushed deliveries (dedupe on event id), this closes any gap from downtime without polling.",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "Last event id already processed; defaults to 0.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ordered events.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid `since`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Caller's resolved IPv4 peer is not allowlisted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/directory/users": {
      "post": {
        "operationId": "ensureDirectoryUser",
        "summary": "Idempotently ensure a central user by email (CIDR-trusted server only)",
        "description": "Requires trusted server admission and a current SUPER_ADMIN app-session bearer. Creates the user if no user holds the normalised email, otherwise returns the existing one; concurrency-safe, and a repeated `idempotencyKey` returns the UID the first call produced. A pre-created user is `claimed: false` until a trusted-provider login with a matching verified email attaches an identity \u2014 untrusted providers can never claim a UID by asserted email. No client-secret header or body field is accepted on any directory endpoint, in any deployment mode.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DirectoryEnsureRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The ensured user (minimal fields only \u2014 never identities, sessions, codes, or OAuth credentials).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectoryUser"
                }
              }
            }
          },
          "400": {
            "description": "Invalid email.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Caller's resolved IPv4 peer is not allowlisted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "AppSession": []
          }
        ]
      },
      "get": {
        "operationId": "searchDirectoryUsers",
        "summary": "Search central users (CIDR-trusted server only)",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "description": "Literal substring matched against email and displayName.",
            "schema": {
              "type": "string",
              "maxLength": 255
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Keyset cursor: the `nextCursor` of the previous page; 0 for the first page.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of users.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectoryPage"
                }
              }
            }
          },
          "400": {
            "description": "limit or cursor out of bounds.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Caller's resolved IPv4 peer is not allowlisted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "AppSession": []
          }
        ],
        "description": "Requires trusted server admission and a current SUPER_ADMIN app-session bearer. "
      }
    },
    "/api/directory/users/{iUserId}": {
      "get": {
        "operationId": "getDirectoryUser",
        "summary": "Fetch one central user by iUserId (CIDR-trusted server only)",
        "parameters": [
          {
            "name": "iUserId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectoryUser"
                }
              }
            }
          },
          "404": {
            "description": "No such user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Caller's resolved IPv4 peer is not allowlisted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "AppSession": []
          }
        ],
        "description": "Requires trusted server admission and a current SUPER_ADMIN app-session bearer. "
      },
      "patch": {
        "summary": "Update user display name (SUPER_ADMIN)",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DirectoryUser"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or revoked actor session"
          },
          "403": {
            "description": "Untrusted server or unauthorized actor"
          },
          "409": {
            "description": "Conflicting record or last administrator removal"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "displayName": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 255
                  }
                },
                "required": [
                  "displayName"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "security": [
          {
            "AppSession": []
          }
        ],
        "parameters": [
          {
            "name": "iUserId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        ]
      }
    },
    "/api/sessions/introspect": {
      "post": {
        "summary": "Read current session and tenant authority (trusted server)",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
