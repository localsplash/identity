    },
    "/api/sessions/select-tenant": {
      "post": {
        "summary": "Persist a permitted enabled tenant in the central session",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "selectedTenantId": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "selectedTenantId"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or revoked actor session"
          },
          "403": {
            "description": "Untrusted server or unauthorized actor"
          },
          "409": {
            "description": "Conflicting record or last administrator removal"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "iTenantId": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "token",
                  "iTenantId"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
