    "/api/directory/tenants/{iTenantId}/users": {
      "post": {
        "summary": "Add user by email to an administered tenant",
        "responses": {
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing or revoked actor session"
          },
          "403": {
            "description": "Untrusted server or unauthorized actor"
          },
          "409": {
            "description": "Conflicting record or last administrator removal"
          },
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Membership"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "role": {
                    "enum": [
                      "SUPER_ADMIN",
                      "TENANT_ADMIN",
                      "USER"
                    ]
                  },
                  "bEnabled": {
                    "type": "boolean"
                  },
                  "displayName": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 255
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 255
                  }
                },
                "required": [
                  "email",
                  "displayName",
                  "role",
                  "bEnabled"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "security": [
          {
            "AppSession": []
          }
        ],
        "parameters": [
          {
            "name": "iTenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "TokenRequest": {
        "type": "object",
        "required": [
          "code",
          "redirect_uri"
        ],
        "additionalProperties": true,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "The one-time handoff code from the /authorize redirect."
          },
          "redirect_uri": {
            "type": "string",
            "format": "uri",
            "description": "Must exactly match the redirect_uri the code was minted for."
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "required": [
          "user",
          "identity",
          "identities",
          "appSession"
        ],
        "properties": {
          "user": {
            "type": "object",
            "required": [
              "iUserId",
              "email",
              "displayName",
              "superAdmin"
            ],
            "properties": {
              "iUserId": {
                "type": "integer",
                "description": "The platform-wide person id (id_db.identity_tbl_User.iUserId)."
              },
              "email": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "displayName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "superAdmin": {
                "type": "boolean",
                "description": "Session-scoped. Provenance: existing SSO Session \u2192 AuthCode \u2192 redemption; a fresh login writes the same calculated value to both Session and AuthCode. Redemption never recalculates from email."
              }
            }
          },
          "identity": {
            "type": "object",
            "required": [
              "provider",
              "subject"
            ],
            "properties": {
              "provider": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "subject": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "description": "The login method this particular sign-in used."
          },
          "identities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "provider",
                "subject",
                "email"
              ],
              "properties": {
                "provider": {
                  "type": "string"
                },
                "subject": {
                  "type": "string"
                },
                "email": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "appSession": {
            "$ref": "#/components/schemas/AppSession"
          }
        }
      },
      "RegistrationRequest": {
        "type": "object",
        "required": [
          "webhook_url"
        ],
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128
          },
          "webhook_url": {
            "type": "string",
            "format": "uri",
            "description": "HTTPS URL on X.TLD or a subdomain where the app receives events."
          }
        }
      },
      "RegistrationResponse": {
        "type": "object",
        "required": [
          "ok",
          "origin",
          "events"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "origin": {
            "type": "string"
          },
          "secret": {
            "type": "string",
            "description": "Legacy webhook-HMAC secret. OPTIONAL to use: POC receivers trust network policy (allowlist id's egress IPv4/CIDRs) plus TLS and are not required to verify signatures."
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventType"
            }
          },
          "signature": {
            "type": "object",
            "description": "Describes the legacy, optional signature scheme.",
            "properties": {
              "header": {
                "type": "string"
              },
              "scheme": {
                "type": "string"
              },
              "toleranceSeconds": {
                "type": "integer"
              },
              "required": {
                "const": false
              }
            }
          }
        }
      },
      "EventType": {
        "type": "string",
        "enum": [
          "ping",
          "session.revoked",
          "user.merged",
          "identity.linked",
          "identity.unlinked"
        ]
      },
      "Event": {
        "type": "object",
        "required": [
          "id",
          "type",
          "occurredAt",
          "data"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "Strictly increasing; the idempotency/replay key. The same id can be delivered more than once \u2014 handlers must dedupe on it."
          },
          "type": {
            "$ref": "#/components/schemas/EventType"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "EventsResponse": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "description": "Oldest first, ordered by id."
          }
        }
      },
      "DirectoryEnsureRequest": {
        "type": "object",
        "required": [
          "email"
        ],
        "additionalProperties": true,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255
          },
          "displayName": {
            "type": "string",
            "maxLength": 255
          },
          "idempotencyKey": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "DirectoryUser": {
        "type": "object",
        "required": [
          "iUserId",
          "email",
          "displayName",
          "claimed"
        ],
        "additionalProperties": false,
        "properties": {
          "iUserId": {
            "type": "integer"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "claimed": {
            "type": "boolean",
            "description": "True once any login method is attached \u2014 a trusted-provider login with a matching verified email claims a pre-created UID; untrusted providers never can."
          }
        },
        "description": "Deliberately minimal: never identities, sessions, codes, or OAuth credentials."
      },
      "DirectoryPage": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DirectoryUser"
            }
          },
          "nextCursor": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Pass as `cursor` for the next page; null when this is the last page."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Generic; 403 bodies never disclose the policy or the resolved peer."
          },
          "correlationId": {
            "type": "string",
            "description": "Present on 403s; matches the server log line carrying the resolved peer IP."
          }
        }
      },
      "AppSession": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      },
      "Tenant": {
        "type": "object",
        "properties": {
          "iTenantId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "bEnabled": {
            "type": "boolean"
          },
          "role": {
            "enum": [
              "TENANT_ADMIN",
              "USER",
              "SUPER_ADMIN"
            ]
          }
        },
        "required": [
          "iTenantId",
          "name",
          "slug",
          "bEnabled",
          "role"
        ],
        "additionalProperties": false
      },
      "Introspection": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "active": {
                "const": false
              }
            },
            "required": [
              "active"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "active": {
                "const": true
              },
              "user": {
                "type": "object",
                "required": [
                  "iUserId",
                  "email",
                  "displayName",
                  "superAdmin"
                ],
                "properties": {
                  "iUserId": {
                    "type": "integer",
                    "description": "The platform-wide person id (id_db.identity_tbl_User.iUserId)."
                  },
                  "email": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "displayName": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "superAdmin": {
                    "type": "boolean",
                    "description": "Session-scoped. Provenance: existing SSO Session \u2192 AuthCode \u2192 redemption; a fresh login writes the same calculated value to both Session and AuthCode. Redemption never recalculates from email."
                  }
                }
              },
              "tenants": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Tenant"
                }
              },
              "selectedTenantId": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "active",
              "user",
              "tenants",
              "selectedTenantId"
            ],
            "additionalProperties": false
          }
        ]
      },
      "Membership": {
        "type": "object",
        "properties": {
          "iUserId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "enum": [
              "SUPER_ADMIN",
              "TENANT_ADMIN",
              "USER"
            ]
          },
          "bEnabled": {
            "type": "boolean"
          },
          "claimed": {
            "type": "boolean"
          },
          "superAdmin": {
            "type": "boolean"
          },
          "membershipRole": {
            "enum": [
              "TENANT_ADMIN",
              "USER"
            ]
          }
        },
        "required": [
          "iUserId",
          "email",
          "displayName",
          "role",
          "bEnabled"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "AppSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque central application session plus trusted server admission"
      }
    }
  }
}
