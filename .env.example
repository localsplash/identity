# Nothing in this file has to be typed by hand.
#
#   scripts/install.sh   generates the two database passwords below and
#                        starts everything.
#   /setup               collects the NocoDB address, the API token and the
#                        trusted network from a browser, then the OAuth
#                        client credentials.
#
# Identity owns its data: docker-compose.yml brings up its MySQL beside it
# and it applies its own schema. The only thing it expects to already exist
# is a NocoDB, which holds the settings table the whole platform reads.

PORT=3200

# ── Generated by scripts/install.sh ──────────────────────────────────────────
# The bundled MySQL. A container cannot be asked for these in a browser the
# way everything else is collected, so they are the one thing installation
# writes here. Changing them after first run means the data directory no
# longer matches; recreate the volume if you must.
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# ── Optional: the settings store ─────────────────────────────────────────────
# Left unset, the first-run wizard asks for these and saves them to
# /data/config.json on the identity-config volume — the zero-config path.
# Set here, they win, are read-only in /admin, and the wizard skips step 1.
# NOCODB_BASE_URL=https://nocodb.example.com
# NOCODB_API_TOKEN=generate-in-nocodb-ui

# ── Optional: pin a setting ──────────────────────────────────────────────────
# Any key from auth_tbl_Settings may also be set here, where it OVERRIDES the
# stored row: read-only in /admin, never copied into the store, and a restart
# to change. Blank counts as unset. This is the escape hatch for deployments
# that manage configuration as environment — the zero-config path leaves all
# of it commented out.
#
# The trusted network. ONE value for the whole platform, normally the
# `trustedCIDR` row that every application reads; the wizard writes it there.
# IDENTITY_TRUSTED_NETWORK=10.9.0.0/16
#
# How applications authenticate to the server-only endpoints:
#   cidr   — POC default: the caller's IPv4 peer must be inside trustedCIDR
#   secret — legacy IDENTITY_CLIENT_SECRET check only (pre-rollout behaviour)
#   dual   — either is accepted (short migration window)
# IDENTITY_APP_AUTH_MODE=cidr
#
# The identity database. These default to the MySQL in docker-compose.yml
# and should not need stating; set them only to point at a database you run
# yourself, in which case the wizard asks for anything still missing.
# DB_HOST=db
# DB_PORT=3306
# DB_USER=identity
# DB_NAME=id_db
#
# APP_BASE_URL=https://identity.example.com
# PARENT_DOMAIN=example.com
# SUPERADMIN_DOMAIN=example.com
# DEFAULT_REDIRECT_URI=https://app.example.com/auth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
