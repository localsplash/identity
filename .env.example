# A platform deployment (compose.yaml) states only how to reach the settings
# store; every setting is a PlatformConfig row (cfg_tbl_Setting, scope
# identity or *). AidaPlatformDB/install.sh apps writes this file.
NOCODB_BASE_URL=https://nocodb.X.TLD
NOCODB_API_TOKEN=

# How applications authenticate to the server-only endpoints (see compose.yaml):
#   cidr   — the caller's IPv4 peer must be inside trustedCIDR
#   secret — the IDENTITY_CLIENT_SECRET row only
#   dual   — either (the default)
# IDENTITY_APP_AUTH_MODE=dual

# Docker objects this host already has, when the defaults differ.
# PROXY_NETWORK=npm_network
# PLATFORM_NETWORK=platform-local
# PORT=3200

# ── compose.dev.yaml: a self-contained local instance ────────────────────────
# scripts/install.sh generates these for the bundled MySQL and starts it. The
# wizard's database step then takes host `db`, user `identity`, database
# `platform_db` and DB_PASSWORD; leave NOCODB_* unset above and the wizard's
# first step asks for them and saves them to /data/config.json instead.
# MYSQL_ROOT_PASSWORD=
# DB_PASSWORD=
